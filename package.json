{
  "name": "shattered-rifts",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.6",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "balance:arena": "pnpm --filter @sr/tools balance:arena",
    "balance:report": "pnpm --filter @sr/tools balance:report",
    "balance:history": "pnpm --filter @sr/tools balance:history",
    "lore:smoke": "pnpm --filter @sr/web lore:smoke",
    "lore:art": "pnpm --filter @sr/tools lore:art",
    "brand:assets": "pnpm --filter @sr/desktop brand:assets",
    "dev": "pnpm --filter @sr/web dev",
    "desktop:build": "pnpm --filter @sr/web build --mode desktop && pnpm --filter @sr/desktop build",
    "desktop:dev": "pnpm desktop:build && pnpm --filter @sr/desktop start",
    "desktop:package": "pnpm desktop:build && pnpm --filter @sr/desktop package",
    "desktop:pack": "pnpm desktop:build && pnpm --filter @sr/desktop pack",
    "desktop:smoke": "pnpm desktop:build && pnpm --filter @sr/desktop smoke",
    "desktop:account:smoke": "pnpm desktop:build && pnpm --filter @sr/desktop account:smoke",
    "desktop:release": "pnpm desktop:package && node apps/desktop/scripts/release.mjs",
    "desktop:release:validate": "node apps/desktop/scripts/release.mjs --validate",
    "desktop:update:smoke": "pnpm desktop:build && node apps/desktop/scripts/update-smoke.mjs",
    "play:smoke": "pnpm --filter @sr/tools play:smoke",
    "auth:browser:smoke": "pnpm --filter @sr/server browser:smoke",
    "build": "pnpm -r --if-present build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "fight": "pnpm --filter @sr/tools fight",
    "sim": "pnpm --filter @sr/tools sim",
    "deploy:web": "pnpm --filter @sr/tools deploy:web",
    "artlist": "pnpm --filter @sr/tools artlist",
    "cardprompts": "pnpm --filter @sr/tools cardprompts",
    "cardlist": "pnpm --filter @sr/tools cardlist",
    "balance": "pnpm --filter @sr/tools balance",
    "runsim": "pnpm --filter @sr/tools runsim",
    "stage1sim": "pnpm --filter @sr/tools stage1sim",
    "bosssim": "pnpm --filter @sr/tools bosssim",
    "poolaudit": "pnpm --filter @sr/tools poolaudit",
    "audit:balance": "pnpm --filter @sr/tools audit:balance",
    "cardscan": "pnpm --filter @sr/tools cardscan",
    "traitscan": "pnpm --filter @sr/tools traitscan",
    "pvpsmoke": "pnpm --filter @sr/tools pvpsmoke",
    "pvpbalance": "pnpm --filter @sr/tools pvpbalance",
    "ghostsim": "pnpm --filter @sr/tools ghostsim",
    "arenasim": "pnpm --filter @sr/tools arenasim",
    "pvp:dev": "pnpm --filter @sr/server dev",
    "cardprompts:extra": "pnpm --filter @sr/tools cardprompts:extra",
    "cardprompts:missing": "pnpm --filter @sr/tools cardprompts:missing",
    "fxprompts:rare": "pnpm --filter @sr/tools fxprompts:rare",
    "fxprompts:uncommon": "pnpm --filter @sr/tools fxprompts:uncommon"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
