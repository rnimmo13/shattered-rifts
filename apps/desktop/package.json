{
  "name": "@sr/desktop",
  "version": "0.182.0",
  "private": true,
  "description": "Shattered Rifts desktop playtest build",
  "author": "Shattered Rifts",
  "type": "commonjs",
  "main": "out/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/configure.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "start": "electron .",
    "package": "electron-builder --win nsis --x64 --publish never",
    "pack": "electron-builder --win --x64 --dir --publish never",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "electron": "45.2.2",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "app.shatteredrifts.desktop",
    "productName": "Shattered Rifts",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "!out/**/*.test.js",
      "!out/smoke.js"
    ],
    "extraResources": [
      {
        "from": "../web/dist-desktop",
        "to": "game"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/steamworks.js/**/*"
    ],
    "extraFiles": [
      {
        "from": "node_modules/steamworks.js/dist/win64/steam_api64.dll",
        "to": "steam_api64.dll"
      }
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Shattered-Rifts-${version}-Setup.${ext}"
    }
  },
  "dependencies": {
    "steamworks.js": "0.4.0"
  }
}
